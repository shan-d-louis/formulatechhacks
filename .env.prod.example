# Production runtime for SIDEWALL FastAPI plus Supabase backing services.
# Copy to .env.prod locally for deploy commands, or set these as secrets in your host.
SIDEWALL_ENV=prod
SIDEWALL_HOST=0.0.0.0
PORT=8000

# Set to the deployed git SHA or release id so /api/model/status stays reproducible.
SIDEWALL_MODEL_VERSION=

# Supabase project settings from Project Settings -> API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# Server-side only. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Leave empty if no database
DATABASE_URL=

BACKEND_BASE_URL=https://YOUR_FASTAPI_HOST