# Local fallback runtime for SIDEWALL FastAPI.
# Copy to .env.local for your machine. Keep this file secret-free.
SIDEWALL_ENV=local
SIDEWALL_HOST=0.0.0.0
PORT=8000
SIDEWALL_MODEL_VERSION=local-dev

# Optional local Supabase values if you run Supabase functions locally.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
BACKEND_BASE_URL=http://localhost:8000
